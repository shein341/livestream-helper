# Answer model: final response generation
RAG_ANSWER_BASE_URL=https://api.minimaxi.com/v1
RAG_ANSWER_MODEL=MiniMax-M2.7-highspeed
RAG_ANSWER_API_KEY=your_answer_api_key_here
RAG_ANSWER_REASONING_SPLIT=true
RAG_ANSWER_THINKING=

# DeepSeek Flash example:
# RAG_ANSWER_BASE_URL=https://api.deepseek.com
# RAG_ANSWER_MODEL=deepseek-v4-flash
# RAG_ANSWER_REASONING_SPLIT=false
# RAG_ANSWER_THINKING=disabled

# Local Ollama models for retrieval-side work
# Docker containers reach the host Ollama service through host.docker.internal.
RAG_OLLAMA_BASE_URL=http://host.docker.internal:11434

# Query rewrite model: small/fast model that rewrites user questions for retrieval
RAG_QUERY_REWRITE_PROVIDER=ollama
RAG_QUERY_REWRITE_MODEL=qwen3.5:4b
# DeepSeek Flash rewrite example:
# RAG_QUERY_REWRITE_PROVIDER=openai
# RAG_QUERY_REWRITE_BASE_URL=https://api.deepseek.com
# RAG_QUERY_REWRITE_API_KEY=your_deepseek_key_here
# RAG_QUERY_REWRITE_MODEL=deepseek-v4-flash
# RAG_QUERY_REWRITE_THINKING=disabled

# Embedding model: local Ollama /api/embed
RAG_EMBEDDING_MODEL=bge-m3:latest

# Rerank model: FlagEmbedding cross-encoder reranker
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
